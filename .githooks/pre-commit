#!/bin/sh
# Mirror the CI quality gates, scoped to what this commit actually touches.
#
# CI runs every job on every push; a hook that did the same would make a
# one-line web tweak pay for the Go race suite. Each block below maps to a job
# in .github/workflows/ci.yml and runs only when a file it covers is staged.
#
# Skip once with `git commit --no-verify`, or set PRE_COMMIT_ALL=1 to force the
# full `make ci` regardless of what changed.
set -e
root="$(git rev-parse --show-toplevel)"
cd "$root"

if [ "${PRE_COMMIT_ALL:-}" = "1" ]; then
  echo "pre-commit: make ci (PRE_COMMIT_ALL=1)"
  make ci
  exit 0
fi

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$staged" ]; then
  exit 0
fi

# Staged paths matching the extended regex in $1?
touched() {
  printf '%s\n' "$staged" | grep -qE "$1"
}

ran=0

# Go job: sources, module files, and the configs that change how they are read.
if touched '\.go$|^go\.(mod|sum)$|^Makefile$|^\.golangci\.yml$'; then
  echo "pre-commit: Go gates (fmt, fix, vet, lint, test -race, coverage)"
  make ci-go
  ran=1
fi

# Web job. web/dist is build output: a commit that only refreshes it does not
# need the frontend gates run again, so it is filtered out here.
if printf '%s\n' "$staged" | grep -E '^web/' | grep -qv '^web/dist/'; then
  echo "pre-commit: web gates (eslint, vitest, build)"
  make web-ci
  ran=1
fi

# Code quality job: whole-program reachability and module hygiene. Both need
# the same inputs as the Go gates, and both are fast enough to always pair.
if touched '\.go$|^go\.(mod|sum)$|^Makefile$'; then
  echo "pre-commit: quality gates (go mod tidy, deadcode)"
  make quality
  ran=1
fi

# License scan job: only the files that can change the dependency graph or the
# policy applied to it.
if touched '^go\.(mod|sum)$|^web/package(-lock)?\.json$|^Makefile$|^web/scripts/check-licenses\.mjs$'; then
  echo "pre-commit: license gates (go-licenses, npm license policy)"
  make licenses
  ran=1
fi

# Deliberately not here: the SAST job. semgrep fetches its rulesets from the
# registry, so it needs network and ~40s on a warm cache -- per-commit is how
# you teach people to reach for --no-verify. It runs in `make ci`, under
# PRE_COMMIT_ALL=1, and on every push.

# Workflow job: the workflows themselves and the zizmor exception list.
if touched '^\.github/workflows/|^\.github/zizmor\.yml$'; then
  echo "pre-commit: workflow gates (actionlint, zizmor)"
  make actions-lint
  ran=1
fi

if [ "$ran" = "0" ]; then
  echo "pre-commit: no gated paths staged, nothing to run"
fi
